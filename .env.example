# Copy to .env and fill in values. Never commit .env.

# --- App ---
# APP_ENV: development | test | production
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- LLM (provider-agnostic; Groq is the default provider) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embeddings (local model, no API key required) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Knowledge graph ---
# GRAPH_BACKEND: memory | neo4j
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required when GRAPH_BACKEND=neo4j and when running docker compose
NEO4J_PASSWORD=

# --- Vector evidence store ---
# VECTOR_BACKEND: local (embedded Qdrant on disk) | qdrant (server)
VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=burhan_evidence

# --- Storage (relative paths resolve from the repo root) ---
DATA_DIR=data
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=20

# --- Chunking (characters) ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
