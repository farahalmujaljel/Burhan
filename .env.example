# Copy to .env and fill in values. Never commit .env.

# --- App ---
# APP_ENV: development | test | production
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- LLM (provider-agnostic; Groq is the default provider) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
# Check available models: https://console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# low | medium | high, for reasoning models; leave empty for non-reasoning models
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
# Repair retries for malformed JSON output
LLM_MAX_RETRIES=2
# HTTP retries for transient errors / 429 rate limits
LLM_HTTP_RETRIES=6
# Groq counts this toward tokens-per-minute (free tier: 8000 TPM for gpt-oss-120b)
LLM_MAX_OUTPUT_TOKENS=4096

# --- Extraction ---
# Characters of paper text sent per extraction call (keep under your Groq tokens-per-minute limit)
EXTRACTION_WINDOW_CHARS=8000
# Claim/quote pairs checked per verification call
VERIFICATION_BATCH_SIZE=12

# --- Embeddings (local model, no API key required) ---
# model2vec: numpy-only static embeddings, works on every platform incl. Intel Macs (default)
# fastembed: ONNX models such as BAAI/bge-small-en-v1.5 (pip install fastembed; needs onnxruntime)
# hashing:   lexical fallback with no model download (tests / fully offline demos)
EMBEDDING_BACKEND=model2vec
EMBEDDING_MODEL=minishlab/potion-retrieval-32M
# Only used by the hashing backend
EMBEDDING_DIM=384

# --- Research Digital Twin ---
RESEARCH_DOMAIN=General

# --- Knowledge graph ---
# GRAPH_BACKEND: memory | neo4j
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required when GRAPH_BACKEND=neo4j and when running docker compose
NEO4J_PASSWORD=
# Optional; defaults to the server's default database
NEO4J_DATABASE=

# --- Vector evidence store ---
# VECTOR_BACKEND: local (embedded Qdrant on disk) | qdrant (server)
VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=burhan_evidence

# --- Storage (relative paths resolve from the repo root) ---
DATA_DIR=data
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=20

# --- Chunking (characters) ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
