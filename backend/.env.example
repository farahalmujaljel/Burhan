# LLM (OpenAI-compatible chat completions endpoint).
# Option A - Groq: set GROQ_API_KEY and leave LLM_BASE_URL unset; the backend then
# uses https://api.groq.com/openai/v1 with model openai/gpt-oss-120b (override with LLM_MODEL).
GROQ_API_KEY=
# Option B - local Ollama (default when no API key is set):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b

# Optional persistence backends (leave empty to use local JSON artifacts only).
DATABASE_URL=
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=burhan-password

# Relative paths are resolved against backend/.
STORAGE_DIR=storage
